# Resend API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Verified sender on your Resend domain (required for production).
# Defaults to onboarding@resend.dev for testing (only delivers to your Resend account email).
# Example with verified domain:
RESEND_FROM_EMAIL=Beratung <kontakt@kleinkraft-hannover.de>
